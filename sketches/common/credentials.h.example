// Copier ce fichier vers credentials.h et remplir vos valeurs
// credentials.h est ignoré par git

#define WIFI_SSID "votre_ssid"
#define WIFI_PASSWORD "votre_mot_de_passe"

// Reseaux supplementaires (Claude_Dashboard) - optionnel, jusqu'a _4
// Le premier reseau declare qui est visible au scan est choisi (ordre = priorite).
#define WIFI_SSID_2 "ssid_autre_site"
#define WIFI_PASSWORD_2 "mot_de_passe_autre_site"

// MQTT (Zigbee2MQTT) - optionnel
#define MQTT_SERVER "zigbee.local"
#define MQTT_PORT 1883
#define MQTT_USER "votre_user"
#define MQTT_PASS "votre_password"

// Point d'acces de secours de l'afficheur (Matrix_Scroller) - optionnel
// Si non defini : SSID "Afficheur-CID" et reseau ouvert.
// Un mot de passe de moins de 8 caracteres = reseau ouvert (contrainte WPA2).
#define AP_SSID "Afficheur-CID"
#define AP_PASSWORD "votre_mot_de_passe_ap"

// MQTT cloud du tableau de bord Claude Code (Claude_Dashboard)
// Scaleway IoT Hub : authentification mTLS par certificat du device "ecran".
// Tout vient de la console Scaleway (IoT Hub > Devices / Overview).
#define DASH_MQTT_SERVER "iot.fr-par.scw.cloud"   // nom d'hote du hub (console)
#define DASH_MQTT_PORT 8883
// Device ID (UUID) du device "ecran" : sert de client ID MQTT (obligatoire)
#define DASH_MQTT_CLIENT_ID "00000000-0000-0000-0000-000000000000"
// Certificat CA du hub (PEM), telecharge depuis la page d'apercu du hub
#define DASH_MQTT_CA_CERT \
    "-----BEGIN CERTIFICATE-----\n" \
    "...\n" \
    "-----END CERTIFICATE-----\n"
// Certificat du device "ecran" (PEM)
#define DASH_MQTT_CLIENT_CERT \
    "-----BEGIN CERTIFICATE-----\n" \
    "...\n" \
    "-----END CERTIFICATE-----\n"
// Cle privee du device "ecran" (PEM, non chiffree). Ne jamais la versionner.
#define DASH_MQTT_CLIENT_KEY \
    "-----BEGIN PRIVATE KEY-----\n" \
    "...\n" \
    "-----END PRIVATE KEY-----\n"
