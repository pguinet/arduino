# Configuration de claude-dash-agent : ~/.config/claude-dash/config.toml
# Ce fichier contient un mot de passe : il DOIT rester en chmod 600
# (l'agent refuse de démarrer sinon).

[mqtt]
host = "votre_host"                 # ex. xxxx.s1.eu.hivemq.cloud
port = 8883
username = "votre_user"             # compte "serveur" : publish claude-dash/<host>/#
password = "votre_mot_de_passe"
tls = true                          # false uniquement pour un Mosquitto local de test
# ca_certs = "/etc/ssl/certs/ca-certificates.crt"   # défaut : CA système
topic_prefix = "claude-dash"
# retain = true                     # false si le broker ne garde pas les messages retained
# client_id = "..."                 # défaut : claude-dash-<hostname>
# certfile = "..."                  # certificat client (mTLS), avec keyfile (chmod 600)
# keyfile = "..."

[agent]
# Nom publié (client id MQTT claude-dash-<hostname> et topic claude-dash/<hostname>/state).
# Défaut : nom court de la machine. Il doit être UNIQUE sur le broker.
# hostname = "srv-dev"
# heartbeat = 60                    # republication minimale en s (5..170)

# --- Exemple : Scaleway IoT Hub, plan Shared (voir README) -------------------
# Remplace les deux sections ci-dessus. Authentification par certificat (mTLS),
# pas de username/password. Le plan Shared ne garde aucun message retained :
# heartbeat court pour que l'écran reçoive l'état vite après son démarrage.
#
# [mqtt]
# host = "iot.fr-par.scw.cloud"                 # voir la console (page du hub)
# port = 8883
# tls = true
# ca_certs = "~/.config/claude-dash/hub-ca.pem" # CA du hub (console)
# certfile = "~/.config/claude-dash/serveur.crt"
# keyfile = "~/.config/claude-dash/serveur.key" # chmod 600, non chiffrée
# client_id = "<Device ID>"                     # UUID du device "serveur" (unique)
# retain = false
# topic_prefix = "claude-dash"
#
# [agent]
# heartbeat = 20
