# Configuration de claude-dash-agent : ~/.config/claude-dash/config.toml
# Il DOIT rester en chmod 600 (l'agent refuse de démarrer sinon).
#
# Par défaut : Scaleway IoT Hub, plan Shared (voir README), authentification par
# certificat client (mTLS), comme l'écran. Remplacer les valeurs « votre_… » :
# l'agent refuse de démarrer tant qu'il en reste une (install.sh le signale aussi).

[mqtt]
host = "iot.fr-par.scw.cloud"                     # voir la console (page du hub)
port = 8883                                       # 443 avec transport = "websockets"
tls = true
# transport = "websockets"                        # MQTT sur wss si le 8883 sortant est filtré
ca_certs = "~/.config/claude-dash/iot-hub-ca.pem" # CA du hub (console)
certfile = "~/.config/claude-dash/serveur.crt"    # certificat du device "serveur"
keyfile = "~/.config/claude-dash/serveur.key"     # chmod 600, non chiffrée
client_id = "votre_device_id_serveur"             # Device ID (UUID) du device "serveur"
# Le plan Shared ne garde aucun message retained : l'écran reçoit l'état au
# prochain heartbeat (voir [agent]).
retain = false
# L'écran n'écoute que claude-dash/+/state : ne pas changer sans modifier
# MQTT_TOPIC dans src/main.cpp.
topic_prefix = "claude-dash"

[agent]
# Nom publié dans le topic claude-dash/<hostname>/state : UNIQUE par serveur
# (A-Z a-z 0-9 . _ -, 32 max). Les filtres de messages du hub l'utilisent.
hostname = "votre_hostname"
heartbeat = 20                                    # republication minimale en s (5..170)

# --- Autre broker (Mosquitto de test, broker avec compte) --------------------
# L'écran ne sait faire que du mTLS : username/password ne servent qu'à un agent
# publiant vers un broker de test ou vers un autre abonné. Remplace [mqtt] :
#
# [mqtt]
# host = "127.0.0.1"
# port = 1883
# tls = false                       # false uniquement pour un Mosquitto local de test
# username = "votre_user"
# password = "votre_mot_de_passe"
# retain = true                     # si le broker garde les messages retained
# # ca_certs absent : CA système ; client_id absent : claude-dash-<hostname>
