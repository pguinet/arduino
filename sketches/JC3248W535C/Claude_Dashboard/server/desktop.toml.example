# Configuration de claude-dash-desktop : ~/.config/claude-dash/desktop.toml
# Il DOIT rester en chmod 600 (l'appli refuse de démarrer sinon).
#
# L'appli s'abonne au hub avec son propre device Scaleway (subscribe seul :
# publish reject #, subscribe accept claude-dash/#), distinct de l'écran et des
# agents : un Device ID n'admet qu'une connexion à la fois. Remplacer les valeurs
# « votre_… » : l'appli refuse de démarrer tant qu'il en reste une.

[mqtt]
host = "iot.fr-par.scw.cloud"                     # voir la console (page du hub)
# MQTT sur wss (443) : le 8883 sortant est filtré sur IF-VL-SEC-P1-PRI.
# Ailleurs, port = 8883 sans transport suffit.
port = 443
transport = "websockets"
tls = true
ca_certs = "~/.config/claude-dash/iot-hub-ca.pem" # CA du hub (console)
certfile = "~/.config/claude-dash/desktop.crt"    # certificat du device de l'appli
keyfile = "~/.config/claude-dash/desktop.key"     # chmod 600, non chiffrée
client_id = "votre_device_id_poste"               # Device ID (UUID) du device de l'appli
# Doit valoir celui des agents (topic claude-dash/<hostname>/state).
topic_prefix = "claude-dash"

[window]
# Coin de l'écran où la fenêtre s'ouvre : top-left, top-right, bottom-left, bottom-right.
corner = "top-right"
